# Supabase / Postgres connection strings.
# DATABASE_URL should be the Transaction Pooler URI for the running app.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# DIRECT_URL should be the Direct URI or Session Pooler URI for Prisma schema updates.
# Use Supabase Connect -> Direct -> Session pooler if the direct IPv6 host is not available.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Optional cloud text/image providers. Leave blank for local-first work.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional hosted-app password gate. Set this in Vercel to protect the workspace.
APP_ACCESS_PASSWORD=""
AUTH_SECRET=""
